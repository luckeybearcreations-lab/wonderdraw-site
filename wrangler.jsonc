{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wonderdraw",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
  // After wonderdraw.net is on Cloudflare, attach it under
  // Workers & Pages → wonderdraw → Settings → Domains & Routes.
}
